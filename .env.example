# Copy to .env and fill in. Everything except the API key has a working default.

# Required for summaries and chat. Without it the app still browses arXiv and
# shows plain abstracts.
OPENAI_API_KEY=sk-...

# Three jobs, three models. Each also takes _REASONING_EFFORT (set to "none" to
# omit the parameter for models that reject it) and _MAX_TOKENS.
#
# Listing blurbs: one cheap pass over an abstract, five per page.
# OPENAI_LISTING_MODEL=gpt-5.6-terra
# OPENAI_LISTING_REASONING_EFFORT=none
# OPENAI_LISTING_MAX_TOKENS=600
#
# The real summarization: reads the whole paper.
# OPENAI_SUMMARY_MODEL=gpt-5.6-sol
# OPENAI_SUMMARY_REASONING_EFFORT=xhigh
# OPENAI_SUMMARY_MAX_TOKENS=16000
#
# Chat: one call per question, so the effort is a notch lower for latency.
# OPENAI_CHAT_MODEL=gpt-5.6-sol
# OPENAI_CHAT_REASONING_EFFORT=high
# OPENAI_CHAT_MAX_TOKENS=8000

# Point at an OpenAI-compatible gateway instead of api.openai.com.
# OPENAI_BASE_URL=https://api.openai.com/v1

# Papers per listing page. Each one costs an API call, so this is capped at 5.
# PAGE_SIZE=5

# Where PDFs, extracted text, metadata, and summaries are cached. Delete to reset.
# CACHE_DIR=.cache

# --- talking to arXiv ---
# Minimum gap between requests. Their API terms ask for 3 seconds; raise it if
# you keep seeing 429s (arXiv rate-limits by IP and the ban outlasts the burst).
# ARXIV_MIN_INTERVAL_MS=3000
#
# How long a listing page stays fresh, so reloads don't re-query arXiv.
# LISTING_TTL_SECS=300
#
# Per-request timeout, extra attempts, and how long to stop asking after being
# turned away. During a cooldown, requests fail instantly instead of queueing.
# ARXIV_TIMEOUT_SECS=20
# ARXIV_MAX_RETRIES=1
# ARXIV_COOLDOWN_SECS=60
#
# Point at a mirror, or at a stub when testing.
# ARXIV_API_URL=https://export.arxiv.org/api/query
# ARXIV_PDF_BASE=https://arxiv.org/pdf

# How much extracted PDF text to send with each kind of request.
# SUMMARY_CONTEXT_CHARS=60000
# CHAT_CONTEXT_CHARS=24000

# BIND_ADDR=127.0.0.1:3000
# RUST_LOG=arxiv_reader=debug
